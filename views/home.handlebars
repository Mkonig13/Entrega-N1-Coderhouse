<section class="card">
  <h2>Productos</h2>

  <form method="get" action="/" style="margin-bottom: 1rem;">
    <input type="hidden" name="page" value="1" />
    <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: flex-end;">
      <div>
        <label for="query">Categoría o disponibilidad (true/false)</label>
        <input id="query" name="query" value="{{query}}" />
      </div>
      <div>
        <label for="sort">Orden por precio</label>
        <select id="sort" name="sort">
          <option value="" {{#unless sort}}selected{{/unless}}>Sin orden</option>
          <option value="asc" {{#if (eq sort "asc")}}selected{{/if}}>Ascendente</option>
          <option value="desc" {{#if (eq sort "desc")}}selected{{/if}}>Descendente</option>
        </select>
      </div>
      <div>
        <label for="limit">Límite</label>
        <input id="limit" name="limit" type="number" min="1" value="{{limit}}" />
      </div>
      <div>
        <label for="cid">ID de carrito (opcional)</label>
        <input id="cid" name="cid" value="{{cartId}}" />
      </div>
      <button type="submit" class="btn btn-primary">Aplicar filtros</button>
    </div>
  </form>

  <p style="margin-bottom: 1rem; font-size: 0.9rem; color: #9ca3af;">
    El carrito se crea automáticamente al agregar el primer producto.
  </p>

  <p style="margin-bottom: 1rem;">
    <a id="view-cart-link" href="#" style="display: none;">Ver carrito actual</a>
  </p>

  {{#if products.length}}
    <ul>
      {{#each products}}
        <li style="margin-bottom: 0.75rem;">
          <strong>{{this.title}}</strong>
          - ${{this.price}}
          - Categoría: {{this.category}}
          - Stock: {{this.stock}}
          <br />
          <a href="/products/{{this._id}}">Ver detalles</a>
          |
          <button
            type="button"
            class="btn btn-primary"
            data-add-to-cart
            data-product-id="{{this._id}}"
          >
            Agregar al carrito
          </button>
        </li>
      {{/each}}
    </ul>

    <nav style="margin-top: 1rem; display: flex; gap: 0.75rem; align-items: center;">
      {{#if hasPrevPage}}
        <a href="{{prevLink}}" class="btn btn-secondary">Anterior</a>
      {{/if}}
      <span>Página {{page}} de {{totalPages}}</span>
      {{#if hasNextPage}}
        <a href="{{nextLink}}" class="btn btn-secondary">Siguiente</a>
      {{/if}}
    </nav>
  {{else}}
    <p>No hay productos para mostrar.</p>
  {{/if}}
</section>

